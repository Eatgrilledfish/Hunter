"support\": [\n            {\n              \"source\": \"news:261:folkLegends:eff6f06a16b8\",\n              \"quote\": \"是不是一小袋银白色的粉末，摸起来凉丝丝的，在黑处自己会发光的那种？那也是武器商店从我这收走的！\"\n            },\n            {\n              \"source\": \"catalog:StarSand:30e14e51bf54\",\n              \"quote\": \"星辰之沙：银白色细沙，在暗处自行闪烁冷光。\"\n            }\n          ]\n        },\n        {\n          \"name\": \"FlameBreath\",\n          \"quantity\": 1,\n          \"support\": [\n            {\n              \"source\": \"news:261:folkLegends:eff6f06a16b8\",\n              \"quote\": \"最邪门的是一个水晶瓶子，里头封着一团橙红色的雾，晃一晃还会自己亮——老板说三样东西是同一个怪人卖给他的\"\n            },\n            {\n              \"source\": \"catalog:FlameBreath:2edf5be38578\",\n              \"quote\": \"烈焰之息：透明晶石瓶，内封一团橙红色雾气，轻轻摇晃时发出微弱光亮。\"\n            }\n          ]\n        }\n      ],\n      \"confidence\": \"high\",\n      \"support\": [\n        {\n          ","team":["4255","defender"],"request_id":"f3ec7ac80500a996","cycle_id":1,"matched":true,"sent_round":521}
