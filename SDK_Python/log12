HUNTER {"schema":3,"run":"b21f391d","sdk":"db5e4bfe8f2d","seq":104,"round":391,"event":"news_prompt","part":9,"parts":11,"offset":19200,"total_chars":24938,"sha256":"736ef41d3e2c8acf32d0c5ed95a1069b524569819311705a7cf693bcf4cc6ba6","encoding":"utf-8","text":"source\": \"map:9ef58ca659cf\", \"quote\": \"\\\"stone\\\": [[12, 29], [23, 20], [29, 30], [38, 7], [40, 9], [40, 14]]\"}]}, \"evidence\": [{\"source\": \"news:1:folkLegends:44482c393a57\", \"quote\": \"西部有一石门\"}, {\"source\": \"map:9ef58ca659cf\", \"quote\": \"\\\"stone\\\": [[12, 29], [23, 20], [29, 30], [38, 7], [40, 9], [40, 14]]\"}], \"status\": \"inferred\", \"version\": 263}}, \"evidence_index\": {\"news:391:folkLegends:0f85ab061a9a\": {\"news:391:folkLegends:0f85ab061a9a#0\": {\"start\": 0, \"end\": 19, \"text\": \"矿区治安最近不太好，据说有人半夜偷矿。\"}, \"news:391:folkLegends:0f85ab061a9a#1\": {\"start\": 19, \"end\": 29, \"text\": \"据说还闹到衙门去了。\"}}, \"news:1:folkLegends:44482c393a57\": {\"news:1:folkLegends:44482c393a57#0\": {\"start\": 0, \"end\": 22, \"text\": \"村里最年长的采药人昨天过世了，活了九十三岁。\"}, \"news:1:folkLegends:44482c393a57#1\": {\"start\": 22, \"end\": 84, \"text\": \"他孙子在整理遗物时发现了一本发霉的笔记，最后一页潦草地写着：\\\"西部有一石门，门需三钥\\\"下面还画了一个圆圈，圆圈里画了三道杠。\"}, \"news:1:folkLegends:44482c393a57#2\": {\"start\": 84, \"end\": 99, \"text\": \"家里人看不懂，打算当废纸烧了。\"}, \"news:1:folkLegends:44482c393a57#3\": {\"start\": 99, \"end\": 130, \"text\": \"南边渡口的船夫抱怨最近水位下降得厉害，船底已经刮了三次礁石了。\"}}, \"news:131:folkLegends:7a6fab9eb9df\": {\"news:131:folkLegends:7a6fab9eb9df#0\": {\"start\": 0, \"end\": 28, \"text\": \"东边林场的伐木工说最近夜里老听见狼嚎，而且声音越来越近。\"}, \"news:131:folkLegends:7a6fab9eb9df#1\": {\"start\": 28, \"end\": 44, \"text\": \"村里组织了巡逻队，今晚开始值夜。\"}}, \"news:261:folkLegends:eff6f06a16b8\": {\"news:261:folkLegends:eff6f06a16b8#0\": {\"start\": 0, \"end\": 32, \"text\": \"集市上来了个倒卖古董的外乡人，说话油腔滑调，摆了一地稀奇玩意儿。\"}, \"news:261:folkLegends:eff6f06a16b8#1\": {\"start\": 32, \"end\": 80, \"text\": \"有人问他见没见过\\\"会发光的石头\\\"，他撇嘴说：\\\"你说的是那种灰白色、上面刻着歪歪扭扭字儿的石板吧？\"}, \"news:261:folkLegends:eff6f06a16b8#2\": {\"start\": 80, \"end\": 126, \"text\": \"我在武器商店老板那儿见过一块，老板说这东西摆在店里好几个月了，根本没人问津，打算当镇纸用了。\"}, \"news:261:folkLegends:eff6f06a16b8#3\": {\"start\": 126, \"end\": 179, \"text\": \"\\\"又有人问\\\"光之尘\\\"是什么，他想了想：\\\"是不是一小袋银白色的粉末，摸起来凉丝丝的，在黑处自己会发光的那种？\"}, \"news:261:folkLegends:eff6f06a16b8#4\": {\"start\": 179, \"end\": 193, \"text\": \"那也是武器商店从我这收走的！\"}, \"news:261:folkLegends:eff6f06a16b8#5\": {\"start\": 193, \"end\": 255, \"text\": \"最邪门的是一个水晶瓶子，里头封着一团橙红色的雾，晃一晃还会自己亮——老板说三样东西是同一个怪人卖给他的，卖完人就再没出现过。\"}, \"news:261:folkLegends:eff6f06a16b8#6\": {\"start\": 255, \"end\": 292, \"text\": \"\\\"说完他压低声音：\\\"我要价不高，你们去武器商店看看就知道了，老板加价不多。\"}, \"news:261:folkLegends:eff6f06a16b8#7\": {\"start\": 292, \"end\": 293, \"text\": \"\\\"\"}}, \"news:131:officialNews:1115d31f6e4d\": {\"news:131:officialNews:1115d31f6e4d#0\": {\"start\": 0, \"end\": 45, \"text\": \"矿业管理局紧急通报：北部铁矿区昨夜发生严重矿井塌方事故","team":["4255","defender"],"request_id":"d30d7b7f7065153b","cycle_id":1,"day":4,"analysis_stage":"dawn_analyze"}
